<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Tart Oven</title>
    <!-- Tart Oven needs macOS 26 or later; Installer refuses older systems. -->
    <allowed-os-versions>
        <os-version min="26.0"/>
    </allowed-os-versions>
    <options customize="never" require-scripts="false"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Tart Oven">
        <pkg-ref id="com.tartoven.pkg"/>
    </choice>
    <pkg-ref id="com.tartoven.pkg" version="@VERSION@">TartOven-component.pkg</pkg-ref>
</installer-gui-script>
